rules_version = '2';

// À coller dans la Console Firebase → Firestore Database → Règles.
// Adaptez le(s) domaine(s) autorisé(s) (doit correspondre à
// ALLOWED_EMAIL_DOMAINS dans assets/js/firebase-config.js) et la liste des
// administrateurs (doit correspondre à ADMIN_EMAILS dans le même fichier).

service cloud.firestore {
  match /databases/{database}/documents {

    function isAcademicUser() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.matches('.*@ac-creteil[.]fr$');
    }

    // Liste à tenir identique à ADMIN_EMAILS dans firebase-config.js.
    function isAdmin() {
      return isAcademicUser()
        && request.auth.token.email.lower() in ['lazzouzi@ac-creteil.fr'];
    }

    function ownsAnnuaireDoc(data) {
      return data.mail is string
        && data.mail.lower() == request.auth.token.email.lower();
    }

    match /annuaire/{docId} {
      allow read: if isAcademicUser();
      allow create: if isAcademicUser() && (isAdmin() || ownsAnnuaireDoc(request.resource.data));
      allow update: if isAcademicUser()
        && (isAdmin() || (ownsAnnuaireDoc(resource.data) && ownsAnnuaireDoc(request.resource.data)));
      allow delete: if isAcademicUser() && (isAdmin() || ownsAnnuaireDoc(resource.data));
    }

    match /ressources/{docId} {
      allow read: if isAcademicUser();
      allow create, update, delete: if isAdmin();
    }

    match /themesReseau/{docId} {
      allow read: if isAcademicUser();
      allow create, update, delete: if isAdmin();
    }

    // Un utilisateur standard peut se déclarer lui-même comme personne
    // ressource (son annuaireId doit correspondre à SA PROPRE fiche annuaire,
    // identifiée par le champ "mail") ; seul un administrateur peut déclarer
    // quelqu'un d'autre.
    function isOwnPersonneRessource(data) {
      return data.annuaireId is string
        && get(/databases/$(database)/documents/annuaire/$(data.annuaireId)).data.mail is string
        && get(/databases/$(database)/documents/annuaire/$(data.annuaireId)).data.mail.lower() == request.auth.token.email.lower();
    }

    match /personnesRessources/{docId} {
      allow read: if isAcademicUser();
      allow create: if isAcademicUser() && (isAdmin() || isOwnPersonneRessource(request.resource.data));
      allow update: if isAcademicUser()
        && (isAdmin() || (isOwnPersonneRessource(resource.data) && isOwnPersonneRessource(request.resource.data)));
      allow delete: if isAcademicUser() && (isAdmin() || isOwnPersonneRessource(resource.data));
    }
  }
}
