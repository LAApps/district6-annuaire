rules_version = '2';

// À coller dans la Console Firebase → Firestore Database → Règles.
// Adaptez le(s) domaine(s) autorisé(s) (doit correspondre à
// ALLOWED_EMAIL_DOMAINS dans assets/js/firebase-config.js) et la liste des
// administrateurs (doit correspondre à ADMIN_EMAILS dans le même fichier).

service cloud.firestore {
  match /databases/{database}/documents {

    function isAcademicUser() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.matches('.*@ac-creteil[.]fr$');
    }

    // Liste à tenir identique à ADMIN_EMAILS dans firebase-config.js.
    function isAdmin() {
      return isAcademicUser()
        && request.auth.token.email.lower() in ['lhaj.azzouzi@ac-creteil.fr'];
    }

    // Seule cette adresse peut gérer le Calendrier — volontairement
    // indépendant de isAdmin(), à tenir identique à CALENDRIER_EDITOR_EMAIL
    // dans firebase-config.js.
    function isCalendrierEditor() {
      return isAcademicUser()
        && request.auth.token.email.lower() == 'lhaj.azzouzi@ac-creteil.fr';
    }

    function ownsAnnuaireDoc(data) {
      return data.mail is string
        && data.mail.lower() == request.auth.token.email.lower();
    }

    match /annuaire/{docId} {
      allow read: if isAcademicUser();
      allow create: if isAcademicUser() && (isAdmin() || ownsAnnuaireDoc(request.resource.data));
      allow update: if isAcademicUser()
        && (isAdmin() || (ownsAnnuaireDoc(resource.data) && ownsAnnuaireDoc(request.resource.data)));
      allow delete: if isAcademicUser() && (isAdmin() || ownsAnnuaireDoc(resource.data));
    }

    match /ressources/{docId} {
      allow read: if isAcademicUser();
      allow create, update, delete: if isAdmin();
    }

    match /themesReseau/{docId} {
      allow read: if isAcademicUser();
      allow create, update, delete: if isAdmin();
    }

    // Un utilisateur standard peut se déclarer lui-même comme personne
    // ressource (son annuaireId doit correspondre à SA PROPRE fiche annuaire,
    // identifiée par le champ "mail") ; seul un administrateur peut déclarer
    // quelqu'un d'autre.
    function isOwnPersonneRessource(data) {
      return data.annuaireId is string
        && get(/databases/$(database)/documents/annuaire/$(data.annuaireId)).data.mail is string
        && get(/databases/$(database)/documents/annuaire/$(data.annuaireId)).data.mail.lower() == request.auth.token.email.lower();
    }

    match /personnesRessources/{docId} {
      allow read: if isAcademicUser();
      allow create: if isAcademicUser() && (isAdmin() || isOwnPersonneRessource(request.resource.data));
      allow update: if isAcademicUser()
        && (isAdmin() || (isOwnPersonneRessource(resource.data) && isOwnPersonneRessource(request.resource.data)));
      allow delete: if isAcademicUser() && (isAdmin() || isOwnPersonneRessource(resource.data));
    }

    // Dépôt de documents : contribution libre à tous les utilisateurs
    // académiques, mais seul l'auteur (ou un administrateur) peut retirer
    // sa propre contribution.
    function isOwnDocument(data) {
      return data.ajoutePar is string
        && data.ajoutePar.lower() == request.auth.token.email.lower();
    }

    match /documents/{docId} {
      allow read: if isAcademicUser();
      allow create: if isAcademicUser() && isOwnDocument(request.resource.data);
      allow delete: if isAcademicUser() && (isAdmin() || isOwnDocument(resource.data));
    }

    // Contacts DSDEN / Rectorat : consultation pour tous, gestion réservée
    // aux administrateurs (y compris l'import Excel).
    match /contactsDsden/{docId} {
      allow read: if isAcademicUser();
      allow create, update, delete: if isAdmin();
    }

    // Catégories de la bibliothèque du Dépôt de documents : consultation pour
    // tous, création/modification/suppression réservées aux administrateurs.
    match /categoriesDepot/{docId} {
      allow read: if isAcademicUser();
      allow create, update, delete: if isAdmin();
    }

    // Calendrier : consultation pour tous, création/modification/suppression
    // des événements réservées exclusivement à isCalendrierEditor() (pas aux
    // administrateurs en général).
    match /evenements/{docId} {
      allow read: if isAcademicUser();
      allow create, update, delete: if isCalendrierEditor();
    }

    // IA-IPR : fiches des référent·es (nom, prénom, téléphone, mail) et leur
    // répartition par ville/discipline. Consultation pour tous, gestion
    // réservée aux administrateurs (y compris l'amorçage initial des données).
    match /iaIprReferents/{docId} {
      allow read: if isAcademicUser();
      allow create, update, delete: if isAdmin();
    }
    match /iaIprSecteurs/{docId} {
      allow read: if isAcademicUser();
      allow create, update, delete: if isAdmin();
    }

    // Question secrète de récupération de mot de passe : l'ID du document EST
    // l'adresse e-mail (en minuscules). Personne ne peut la LIRE depuis le
    // client (même pas son propriétaire) — seule la fonction serveur Vercel,
    // via le SDK Admin qui contourne ces règles, peut la consulter pour
    // vérifier la réponse et réinitialiser le mot de passe. Chacun peut créer
    // ou mettre à jour uniquement SA PROPRE question (document dont l'ID
    // correspond à son adresse de connexion).
    match /recoverySecrets/{emailId} {
      allow read: if false;
      allow create, update: if isAcademicUser() && request.auth.token.email.lower() == emailId;
      allow delete: if false;
    }
  }
}
