rules_version = '2';

// À coller dans la Console Firebase → Storage → Règles.
// Adaptez le(s) domaine(s) autorisé(s) ci-dessous (doit correspondre à
// ALLOWED_EMAIL_DOMAINS dans assets/js/firebase-config.js).

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.matches('.*@ac-creteil[.]fr$');
    }
  }
}
